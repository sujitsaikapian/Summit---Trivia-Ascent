      '<circle class="node-dot'+(isCp?' checkpoint':'')+'" id="dot-'+i+'" cx="'+x+'" cy="'+y+'" r="'+(isCp?9:6.5)+'"/>'+
      '<text class="node-label" id="lbl-'+i+'" x="'+(x>100? x+16 : x-16)+'" y="'+(y+3)+'" text-anchor="'+(x>100?'start':'end')+'">L'+(i+1)+'</text>'+
