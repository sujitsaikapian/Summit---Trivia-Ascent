/* ============================================================
   AUDIO ENGINE
   Everything is synthesized (oscillators + generated noise) —
   no external audio files, so nothing here can be copyrighted.
============================================================ */
let audioCtx=null;
let masterGain=null;
let audioMuted=false;
let noiseBufferCache=null;

function ctx(){
  if(!audioCtx){
    try{
      audioCtx=new (window.AudioContext||window.webkitAudioContext)();
      masterGain=audioCtx.createGain();
      masterGain.gain.value = audioMuted ? 0 : 1;
      masterGain.connect(audioCtx.destination);
    }catch(e){ return null; }
  }
  if(audioCtx.state==='suspended') audioCtx.resume();
  return audioCtx;
}
function master(){ ctx(); return masterGain; }

function getNoiseBuffer(){
  const c=ctx(); if(!c) return null;
  if(!noiseBufferCache){
    const len=c.sampleRate*2;
    noiseBufferCache=c.createBuffer(1,len,c.sampleRate);
    const data=noiseBufferCache.getChannelData(0);
    for(let i=0;i<len;i++) data[i]=Math.random()*2-1;
  }
  return noiseBufferCache;
}
// Synthetic room impulse response (exponentially-decaying noise) so the
// applause has a real space around it instead of sounding dry/synthetic.
let reverbImpulseCache=null;
function getReverbImpulse(){
  const c=ctx(); if(!c) return null;
  if(!reverbImpulseCache){
    const len=Math.floor(c.sampleRate*1.1);
    const buf=c.createBuffer(2,len,c.sampleRate);
    for(let ch=0; ch<2; ch++){
      const data=buf.getChannelData(ch);
      for(let i=0;i<len;i++) data[i]=(Math.random()*2-1)*Math.pow(1-i/len,2.4);
    }
    reverbImpulseCache=buf;
  }
  return reverbImpulseCache;
}

function tone(freq,start,dur,type,gainPeak){
  const c=ctx(); if(!c) return;
  const osc=c.createOscillator(); const gain=c.createGain();
  osc.type=type||'sine'; osc.frequency.value=freq;
  osc.connect(gain); gain.connect(master());
  const t0=c.currentTime+start;
  gain.gain.setValueAtTime(0,t0);
  gain.gain.linearRampToValueAtTime(gainPeak||0.12,t0+0.02);
  gain.gain.exponentialRampToValueAtTime(0.001,t0+dur);
  osc.start(t0); osc.stop(t0+dur+0.02);
}
function playTick(){ tone(880,0,0.06,'square',0.05); }

// A single filtered-noise "clap" — layering many of these, spread and
// filtered differently, with random timing/pitch/pan, is the standard
// synthesis trick for a crowd; the room reverb (see playApplause) is what
// glues them into something that reads as real applause rather than clicks.
function clapBurst(bus, startTime, peak){
  const c=ctx(); const buf=getNoiseBuffer(); if(!c||!buf||!bus) return;
  const src=c.createBufferSource(); src.buffer=buf;
  const bp=c.createBiquadFilter(); bp.type='bandpass';
  bp.frequency.value=900+Math.random()*4200; bp.Q.value=0.6+Math.random()*2.2;
  const g=c.createGain();
  let last=bp;
  if(c.createStereoPanner){
    const pan=c.createStereoPanner(); pan.pan.value=(Math.random()*2-1)*0.75;
    bp.connect(pan); last=pan;
  }
  src.connect(bp); last.connect(g); g.connect(bus);
  const dur=0.035+Math.random()*0.075;
  g.gain.setValueAtTime(0,startTime);
  g.gain.linearRampToValueAtTime(peak*(0.5+Math.random()*0.5),startTime+0.004);
  g.gain.exponentialRampToValueAtTime(0.001,startTime+dur);
  const offset=Math.random()*1.6;
  src.start(startTime,offset,dur+0.02);
  src.stop(startTime+dur+0.03);
}
function playApplause(){
  const c=ctx(); if(!c) return;
  const now=c.currentTime;
  const totalDur=1.9;

  // Shared "room": every clap and the ambient wash route through this bus,
  // split into a dry path and a reverb-send path, so they share one space.
  const bus=c.createGain(); bus.gain.value=1;
  const dry=c.createGain(); dry.gain.value=0.8;
  const wetSend=c.createGain(); wetSend.gain.value=0.55;
  const wetOut=c.createGain(); wetOut.gain.value=0.55;
  const convolver=c.createConvolver();
  const ir=getReverbImpulse(); if(ir) convolver.buffer=ir;
  bus.connect(dry); dry.connect(master());
  bus.connect(wetSend); wetSend.connect(convolver); convolver.connect(wetOut); wetOut.connect(master());

  // Overall crowd dynamic: quick swell in, held, then a natural taper out —
  // real applause isn't flat, it breathes.
  bus.gain.cancelScheduledValues(now);
  bus.gain.setValueAtTime(0.0001, now);
  bus.gain.exponentialRampToValueAtTime(1, now+0.1);
  bus.gain.setValueAtTime(1, now+totalDur*0.62);
  bus.gain.exponentialRampToValueAtTime(0.0001, now+totalDur);

  // Ambient "roar" wash fills the gaps between individual claps — real
  // crowds aren't just discrete pops, there's a continuous texture under it.
  const buf=getNoiseBuffer();
  if(buf){
    const src=c.createBufferSource(); src.buffer=buf;
    const bp=c.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=2300; bp.Q.value=0.45;
    const g=c.createGain();
    src.connect(bp); bp.connect(g); g.connect(bus);
    g.gain.setValueAtTime(0, now);
    g.gain.linearRampToValueAtTime(0.05, now+0.15);
    g.gain.setValueAtTime(0.05, now+totalDur*0.55);
    g.gain.exponentialRampToValueAtTime(0.001, now+totalDur);
    const offset=Math.random()*0.5;
    src.start(now, offset, totalDur+0.05);
    src.stop(now+totalDur+0.06);
  }

  // Dense, irregular cloud of claps in three phases: a sudden reaction
  // burst, a sustained wash, then a thinning taper — matching how a real
  // crowd's applause actually evolves rather than a flat random spread.
  for(let i=0;i<24;i++) clapBurst(bus, now+Math.random()*0.3, 0.15+Math.random()*0.05);
  for(let i=0;i<36;i++) clapBurst(bus, now+0.3+Math.random()*1.15, 0.13+Math.random()*0.05);
  for(let i=0;i<12;i++) clapBurst(bus, now+1.45+Math.random()*0.4, 0.09+Math.random()*0.04);

  if(musicEngine.playing) musicEngine.duck(0.28, 2000);
}

function playCorrect(){
  tone(523,0,0.15,'sine',0.1); tone(659,0.1,0.15,'sine',0.1); tone(784,0.2,0.25,'sine',0.12);
  playApplause();
}

// A single "sad trombone" note with a downward pitch bend on the final hit.
function brassNote(freq,t0,dur,bend){
  const c=ctx(); if(!c) return;
  const osc=c.createOscillator(); osc.type='sawtooth';
  const osc2=c.createOscillator(); osc2.type='triangle';
  const filt=c.createBiquadFilter(); filt.type='lowpass'; filt.frequency.value=1500;
  const g=c.createGain();
  osc.frequency.setValueAtTime(freq,t0);
  osc2.frequency.setValueAtTime(freq/2,t0);
  if(bend){
    osc.frequency.exponentialRampToValueAtTime(freq*0.75,t0+dur);
    osc2.frequency.exponentialRampToValueAtTime(freq*0.375,t0+dur);
  }
  osc.connect(filt); osc2.connect(filt); filt.connect(g); g.connect(master());
  g.gain.setValueAtTime(0,t0);
  g.gain.linearRampToValueAtTime(0.1,t0+0.03);
