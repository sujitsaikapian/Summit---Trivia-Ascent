// Looping dramatic background score: a slow, dark pad with a filter LFO
// for movement, plus a heartbeat-like pulse whose tempo and brightness
// climb with the player's altitude. Entirely synthesized, no samples.
const musicEngine = {
  playing:false, nodes:null, pulseTimeout:null, level:1, gainTarget:0.05,
  start(){
    if(this.playing) return;
    const c=ctx(); if(!c) return;
    this.playing=true;
    const mg=c.createGain(); mg.gain.value=0; mg.connect(master());
    const filt=c.createBiquadFilter(); filt.type='lowpass'; filt.frequency.value=400; filt.Q.value=0.7;
    filt.connect(mg);
    const freqs=[73.42,146.83,220.00,349.23]; // D2, D3, A3, F4 — dark, quietly tense
    const oscs=freqs.map((f,idx)=>{
      const o=c.createOscillator();
      o.type = idx===0 ? 'sine' : 'triangle';
      o.frequency.value=f;
      const og=c.createGain(); og.gain.value = idx===0 ? 0.5 : 0.2;
      o.connect(og); og.connect(filt); o.start();
      return {osc:o, gain:og};
    });
    const lfo=c.createOscillator(); lfo.type='sine'; lfo.frequency.value=0.06;
    const lfoGain=c.createGain(); lfoGain.gain.value=90;
    lfo.connect(lfoGain); lfoGain.connect(filt.frequency); lfo.start();
    this.nodes={mg,filt,oscs,lfo};
    this.gainTarget=0.045+this.level*0.0025;
    mg.gain.linearRampToValueAtTime(this.gainTarget, c.currentTime+1.4);
    this._scheduleBeat();
  },
  _scheduleBeat(){
    if(!this.playing) return;
    this._beat();
    const bpm=68+this.level*3.2;
    this.pulseTimeout=setTimeout(()=>this._scheduleBeat(), 60000/bpm);
  },
  _beat(){
    const c=ctx(); if(!c||!this.playing) return;
    const t0=c.currentTime;
    const o=c.createOscillator(); o.type='sine'; o.frequency.value=58;
    const g=c.createGain();
    o.connect(g); g.connect(master());
    g.gain.setValueAtTime(0,t0);
    g.gain.linearRampToValueAtTime(0.085,t0+0.02);
    g.gain.exponentialRampToValueAtTime(0.001,t0+0.28);
    o.start(t0); o.stop(t0+0.3);
  },
  setLevel(i){
    this.level=i;
    this.gainTarget=0.045+i*0.0025;
    if(!this.nodes) return;
    const c=ctx(); const now=c.currentTime;
    this.nodes.mg.gain.cancelScheduledValues(now);
    this.nodes.mg.gain.setValueAtTime(this.nodes.mg.gain.value, now);
    this.nodes.mg.gain.linearRampToValueAtTime(this.gainTarget, now+1.2);
    this.nodes.filt.frequency.cancelScheduledValues(now);
    this.nodes.filt.frequency.setValueAtTime(this.nodes.filt.frequency.value, now);
    this.nodes.filt.frequency.linearRampToValueAtTime(380+i*20, now+1.2);
  },
  duck(factor, ms){
    if(!this.nodes) return;
    const c=ctx(); const now=c.currentTime;
    const g=this.nodes.mg.gain;
    g.cancelScheduledValues(now);
    g.setValueAtTime(g.value, now);
    g.linearRampToValueAtTime(this.gainTarget*factor, now+0.08);
    g.linearRampToValueAtTime(this.gainTarget, now+ms/1000);
  },
  stop(){
    if(!this.playing) return;
    this.playing=false;
    if(this.pulseTimeout) clearTimeout(this.pulseTimeout);
    const c=ctx();
    if(this.nodes && c){
      const {mg,oscs,lfo}=this.nodes;
      const now=c.currentTime;
      mg.gain.cancelScheduledValues(now);
      mg.gain.setValueAtTime(mg.gain.value, now);
      mg.gain.linearRampToValueAtTime(0, now+0.6);
      setTimeout(()=>{ try{ oscs.forEach(o=>o.osc.stop()); lfo.stop(); }catch(e){} }, 700);
    }
    this.nodes=null;
  }
};

