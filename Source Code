<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SUMMIT — The Trivia Ascent</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --void:#0b0e1a;
  --void-2:#080a13;
  --altitude:#141a2e;
  --altitude-2:#1c2440;
  --altitude-3:#242c4d;
  --beacon:#e8a33d;
  --beacon-soft:#f2c572;
  --ember:#e2543a;
  --frost:#8fb8d6;
  --frost-soft:#bfd7ea;
  --snow:#f1eee6;
  --snow-dim:#a9a6a0;
  --line:rgba(241,238,230,0.09);
  --glass:rgba(20,26,46,0.55);
  --font-display:'Fraunces',serif;
  --font-body:'Manrope',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --ease:cubic-bezier(.22,1,.36,1);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:radial-gradient(ellipse 120% 80% at 50% -10%, #1a2140 0%, var(--void) 45%, var(--void-2) 100%);
  color:var(--snow);
  font-family:var(--font-body);
  min-height:100vh;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,.display{font-family:var(--font-display);font-weight:700;letter-spacing:-0.01em;}
.mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums;}
a{color:inherit;}
button{font-family:var(--font-body);cursor:pointer;}
::selection{background:var(--beacon);color:var(--void);}
:focus-visible{outline:2px solid var(--beacon-soft);outline-offset:3px;border-radius:4px;}

#bg-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:0.65;}

#app{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column;}

.screen{display:none;flex:1;flex-direction:column;min-height:100vh;padding:24px;}
.screen.active{display:flex;}

/* ============ SHARED UI ============ */
.brandmark{display:inline-flex;align-items:center;gap:10px;}
.peak-icon{width:26px;height:26px;flex-shrink:0;}
.brand-word{font-family:var(--font-display);font-weight:800;font-size:1.15rem;letter-spacing:0.04em;}

.btn{
  border:1px solid var(--line);
  background:var(--glass);
  color:var(--snow);
  padding:14px 26px;
  border-radius:10px;
  font-size:0.95rem;
  font-weight:600;
  backdrop-filter:blur(12px);
  transition:transform .18s var(--ease), border-color .18s, background .18s, box-shadow .18s;
  -webkit-backdrop-filter:blur(12px);
}
.btn:hover{transform:translateY(-2px);border-color:rgba(232,163,61,0.5);}
.btn:active{transform:translateY(0);}
.btn:disabled{opacity:0.35;cursor:not-allowed;transform:none;}
.btn-primary{
  background:linear-gradient(135deg,var(--beacon),#c97f27);
  color:#211200;
  border:none;
  font-weight:700;
  box-shadow:0 8px 24px -8px rgba(232,163,61,0.55);
}
.btn-primary:hover{box-shadow:0 12px 30px -8px rgba(232,163,61,0.7);}
.btn-ghost{background:transparent;border:1px solid var(--line);}
.btn-danger-outline{border:1px solid rgba(226,84,58,0.4);color:var(--ember);background:rgba(226,84,58,0.08);}

.card{
  background:var(--glass);
  border:1px solid var(--line);
  border-radius:16px;
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
}

.eyebrow{font-family:var(--font-mono);font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--frost-soft);opacity:0.85;}

/* ============ WELCOME ============ */
#screen-welcome{align-items:center;justify-content:center;text-align:center;position:relative;}
.welcome-inner{max-width:560px;width:100%;position:relative;z-index:2;padding:20px 0 60px;}
.welcome-top{display:flex;justify-content:center;margin-bottom:38px;opacity:0;animation:fadeUp .9s var(--ease) forwards;}
.welcome-title{
  font-size:clamp(3rem,11vw,5.2rem);
  line-height:0.95;
  margin:0 0 14px;
  background:linear-gradient(180deg,var(--snow) 0%, var(--beacon-soft) 120%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  opacity:0;animation:fadeUp .9s .12s var(--ease) forwards;
}
.welcome-tagline{
  color:var(--snow-dim);
  font-size:1.02rem;
  margin:0 0 36px;
  opacity:0;animation:fadeUp .9s .24s var(--ease) forwards;
}
.name-row{display:flex;gap:10px;justify-content:center;margin-bottom:20px;flex-wrap:wrap;opacity:0;animation:fadeUp .9s .36s var(--ease) forwards;}
#input-name{
  background:rgba(255,255,255,0.04);
  border:1px solid var(--line);
  color:var(--snow);
  padding:14px 18px;
  border-radius:10px;
  font-family:var(--font-body);
  font-size:0.95rem;
  width:230px;
  text-align:center;
}
#input-name::placeholder{color:var(--snow-dim);}
.welcome-cta{opacity:0;animation:fadeUp .9s .48s var(--ease) forwards;display:flex;flex-direction:column;align-items:center;gap:14px;}
.best-badge{
  display:inline-flex;gap:8px;align-items:center;
  font-family:var(--font-mono);font-size:0.82rem;color:var(--beacon-soft);
  opacity:0;animation:fadeUp .9s .6s var(--ease) forwards;
}
.link-btn{background:none;border:none;color:var(--frost-soft);text-decoration:underline;text-underline-offset:3px;font-size:0.85rem;opacity:0.8;}
.link-btn:hover{opacity:1;}

.howto{max-width:520px;margin:34px auto 0;text-align:left;opacity:0;animation:fadeUp .9s .7s var(--ease) forwards;}
.howto summary{cursor:pointer;color:var(--frost-soft);font-size:0.85rem;list-style:none;display:flex;align-items:center;gap:6px;}
.howto summary::-webkit-details-marker{display:none;}
.howto summary::before{content:'▸';transition:transform .2s;}
.howto[open] summary::before{transform:rotate(90deg);}
.howto-body{padding:14px 4px 4px;color:var(--snow-dim);font-size:0.84rem;line-height:1.65;}
.howto-body b{color:var(--snow);}

@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}

/* mountain silhouette parallax */
.mtn-layer{position:absolute;left:0;right:0;bottom:0;height:220px;pointer-events:none;z-index:0;}

/* ============ CATEGORY ============ */
#screen-category{align-items:center;padding-top:60px;}
.cat-wrap{max-width:820px;width:100%;margin:0 auto;}
.cat-header{text-align:center;margin-bottom:34px;}
.cat-header h2{font-size:1.9rem;margin:8px 0 6px;}
.cat-header p{color:var(--snow-dim);margin:0;font-size:0.92rem;}
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
@media(max-width:720px){.cat-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:480px){.cat-grid{grid-template-columns:repeat(2,1fr);}}
.cat-card{
  padding:20px 12px;border-radius:14px;text-align:center;
  display:flex;flex-direction:column;align-items:center;gap:8px;
  transition:transform .18s var(--ease), border-color .18s, background .18s;
}
.cat-card .ic{font-size:1.7rem;}
.cat-card .nm{font-size:0.82rem;font-weight:600;}
.cat-card:hover{transform:translateY(-3px);border-color:rgba(232,163,61,0.5);background:rgba(232,163,61,0.08);}
.back-link{margin-top:30px;text-align:center;}

/* ============ LOADING ============ */
#screen-loading{align-items:center;justify-content:center;text-align:center;}
.compass{width:64px;height:64px;margin:0 auto 22px;position:relative;}
.compass svg{width:100%;height:100%;animation:spin 2.4s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.loading-txt{color:var(--snow-dim);font-size:0.9rem;}
.loading-txt b{color:var(--beacon-soft);}

/* ============ GAME ============ */
#screen-game{padding:16px 68px 20px 20px;}
.game-shell{display:flex;gap:22px;max-width:1180px;margin:0 auto;width:100%;flex:1;}
.game-main{flex:1;display:flex;flex-direction:column;min-width:0;}
.game-side{width:150px;flex-shrink:0;display:flex;justify-content:center;}
@media(max-width:760px){.game-side{width:56px;}}

.game-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:10px;}
.hdr-stat{text-align:right;}
.hdr-stat .lbl{font-size:0.68rem;color:var(--snow-dim);text-transform:uppercase;letter-spacing:0.08em;}
.hdr-stat .val{font-family:var(--font-mono);font-weight:700;color:var(--beacon-soft);font-size:1.05rem;}

.host-line{
  font-family:var(--font-display);font-style:italic;font-size:0.95rem;color:var(--frost-soft);
  padding:10px 16px;border-left:2px solid var(--beacon);margin-bottom:16px;opacity:0;
  animation:fadeUp .5s var(--ease) forwards;min-height:1.4em;
}

.q-card{padding:28px 26px;margin-bottom:18px;position:relative;overflow:hidden;}
.q-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;gap:14px;}
.q-tier{font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--beacon-soft);}
.q-level{color:var(--snow-dim);font-size:0.7rem;font-family:var(--font-mono);}
.q-text{font-family:var(--font-display);font-size:1.35rem;line-height:1.4;margin:0 0 22px;font-weight:600;}

.timer-ring{width:56px;height:56px;flex-shrink:0;position:relative;}
.timer-ring svg{width:100%;height:100%;transform:rotate(-90deg);}
.timer-ring circle{fill:none;stroke-width:5;}
.timer-track{stroke:rgba(255,255,255,0.08);}
.timer-fill{stroke:var(--beacon);stroke-linecap:round;transition:stroke-dashoffset 1s linear, stroke .3s;}
.timer-ring.critical .timer-fill{stroke:var(--ember);}
.timer-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:0.82rem;font-weight:700;}
.timer-ring.critical .timer-num{color:var(--ember);}

.opts{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:560px){.opts{grid-template-columns:1fr;}}
.opt-btn{
  text-align:left;padding:15px 16px;border-radius:11px;
  border:1px solid var(--line);background:rgba(255,255,255,0.03);color:var(--snow);
  display:flex;gap:12px;align-items:flex-start;font-size:0.92rem;line-height:1.4;
  transition:all .15s var(--ease);
}
.opt-btn .k{font-family:var(--font-mono);font-weight:700;color:var(--beacon-soft);flex-shrink:0;}
.opt-btn:hover:not(:disabled):not(.removed){border-color:rgba(232,163,61,0.5);background:rgba(232,163,61,0.07);transform:translateY(-1px);}
.opt-btn:disabled{cursor:default;}
.opt-btn.removed{opacity:0.15;pointer-events:none;}
.opt-btn.correct{border-color:var(--beacon);background:rgba(232,163,61,0.18);box-shadow:0 0 0 1px var(--beacon);}
.opt-btn.incorrect{border-color:var(--ember);background:rgba(226,84,58,0.18);box-shadow:0 0 0 1px var(--ember);}
.opt-btn.dim{opacity:0.35;}

.controls-row{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px;margin-top:4px;}
.lifelines{display:flex;gap:14px;}
.life-item{display:flex;flex-direction:column;align-items:center;gap:7px;width:82px;}
.life-btn{
  width:52px;height:52px;border-radius:50%;border:1px solid var(--line);background:var(--glass);
  display:flex;align-items:center;justify-content:center;color:var(--beacon-soft);position:relative;flex-shrink:0;
  transition:all .18s var(--ease);
}
.life-btn svg{width:22px;height:22px;display:block;}
.life-btn:hover:not(:disabled){border-color:var(--beacon);transform:translateY(-2px);}
.life-btn:disabled{opacity:0.25;cursor:not-allowed;}
.life-btn .spin{width:18px;height:18px;border:2px solid rgba(255,255,255,0.2);border-top-color:var(--beacon);border-radius:50%;animation:spin .8s linear infinite;}
.life-caption{
  font-family:var(--font-mono);font-size:0.62rem;line-height:1.3;text-align:center;
  color:var(--snow-dim);letter-spacing:0.01em;transition:opacity .18s var(--ease);
}
.life-caption b{display:block;color:var(--snow);font-weight:700;font-size:0.66rem;margin-bottom:2px;letter-spacing:0.02em;}
.life-btn:disabled ~ .life-caption{opacity:0.4;}

.expert-bubble{
  margin-top:14px;padding:14px 16px;border-radius:12px;background:rgba(143,184,214,0.08);
  border:1px solid rgba(143,184,214,0.25);font-size:0.85rem;line-height:1.55;color:var(--frost-soft);
  animation:fadeUp .4s var(--ease) forwards;
}
.expert-bubble b{color:var(--snow);}

.continue-panel{padding:22px 26px;text-align:center;}
.fact-txt{color:var(--snow-dim);font-size:0.88rem;line-height:1.6;margin:10px 0 18px;font-style:italic;}

/* ladder */
.ladder-wrap{position:sticky;top:16px;height:fit-content;}
.ladder-svg{width:100%;height:auto;overflow:visible;}
.node-dot{fill:var(--altitude-2);stroke:var(--line);stroke-width:2;transition:all .3s var(--ease);}
.node-dot.passed{fill:var(--frost);stroke:var(--frost);}
.node-dot.current{fill:var(--beacon);stroke:var(--beacon-soft);}
.node-dot.checkpoint{stroke:var(--beacon-soft);stroke-width:3;}
.node-label{font-family:var(--font-mono);font-size:9px;fill:var(--snow-dim);}
.node-label.current{fill:var(--beacon-soft);font-weight:700;}
.node-amt{font-family:var(--font-mono);font-size:8px;fill:var(--snow-dim);}
.node-amt.current{fill:var(--snow);}
.trail-line{stroke:var(--line);stroke-width:2;stroke-dasharray:4 5;fill:none;}
.trail-line.passed{stroke:var(--frost);opacity:0.5;}
.beacon-glow{filter:drop-shadow(0 0 8px var(--beacon));}
@media(max-width:760px){.node-label,.node-amt{display:none;}}

/* ============ RESULT ============ */
#screen-result{align-items:center;justify-content:center;text-align:center;padding-top:40px;}
.result-inner{max-width:520px;width:100%;}
.result-eyebrow{margin-bottom:10px;}
.result-title{font-size:clamp(2rem,7vw,2.8rem);margin:0 0 14px;}
.result-amt{
  font-family:var(--font-mono);font-weight:700;font-size:clamp(2.4rem,10vw,3.6rem);
  color:var(--beacon-soft);margin:6px 0 18px;
}
.result-copy{color:var(--snow-dim);font-size:0.92rem;line-height:1.6;margin:0 0 26px;}
.result-copy .missed{color:var(--ember);}
.save-row{display:flex;gap:10px;justify-content:center;margin:22px 0;flex-wrap:wrap;}
#input-lb-name{
  background:rgba(255,255,255,0.04);border:1px solid var(--line);color:var(--snow);
  padding:12px 16px;border-radius:10px;font-family:var(--font-body);font-size:0.9rem;width:200px;text-align:center;
}
.result-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:10px;}
.saved-note{color:var(--frost-soft);font-size:0.85rem;margin-top:10px;}

/* ============ LEADERBOARD ============ */
#screen-leaderboard{align-items:center;padding-top:60px;}
.lb-wrap{max-width:560px;width:100%;}
.lb-header{text-align:center;margin-bottom:26px;}
.lb-list{padding:8px;}
.lb-row{display:flex;align-items:center;gap:14px;padding:12px 14px;border-bottom:1px solid var(--line);}
.lb-row:last-child{border-bottom:none;}
.lb-rank{font-family:var(--font-mono);width:26px;color:var(--snow-dim);font-size:0.85rem;flex-shrink:0;}
.lb-row:nth-child(1) .lb-rank, .lb-row:nth-child(2) .lb-rank, .lb-row:nth-child(3) .lb-rank{color:var(--beacon-soft);font-weight:700;}
.lb-name{flex:1;font-weight:600;font-size:0.9rem;}
.lb-cat{color:var(--snow-dim);font-size:0.72rem;font-family:var(--font-mono);}
.lb-amt{font-family:var(--font-mono);color:var(--beacon-soft);font-weight:700;font-size:0.92rem;}
.lb-empty{text-align:center;padding:40px 20px;color:var(--snow-dim);font-size:0.9rem;}
.lb-note{text-align:center;color:var(--snow-dim);font-size:0.72rem;margin-top:14px;opacity:0.7;}

/* ============ TOASTS / CONFETTI ============ */
#toast-container{position:fixed;top:22px;left:50%;transform:translateX(-50%);z-index:50;display:flex;flex-direction:column;gap:8px;align-items:center;}
.toast{
  background:rgba(20,26,46,0.92);border:1px solid rgba(232,163,61,0.4);color:var(--snow);
  padding:12px 20px;border-radius:10px;font-size:0.85rem;backdrop-filter:blur(10px);
  animation:toastIn .3s var(--ease) forwards, toastOut .3s var(--ease) 2.6s forwards;
  box-shadow:0 8px 24px -8px rgba(0,0,0,0.5);
}
@keyframes toastIn{from{opacity:0;transform:translateY(-10px);}to{opacity:1;transform:translateY(0);}}
@keyframes toastOut{to{opacity:0;transform:translateY(-10px);}}
#confetti-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:40;pointer-events:none;}
.mute-btn{
  position:fixed;top:18px;right:18px;z-index:55;
  width:42px;height:42px;border-radius:50%;
  border:1px solid var(--line);background:var(--glass);color:var(--snow);
  font-size:1.05rem;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  display:flex;align-items:center;justify-content:center;transition:all .18s var(--ease);
}
.mute-btn:hover{border-color:var(--beacon);transform:translateY(-2px);}

.shake{animation:shake .4s var(--ease);}
@keyframes shake{0%,100%{transform:translateX(0);}20%{transform:translateX(-8px);}40%{transform:translateX(7px);}60%{transform:translateX(-5px);}80%{transform:translateX(3px);}}

.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);}

.modal-overlay{position:fixed;inset:0;background:rgba(8,10,19,0.78);z-index:60;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(3px);}
.modal-card{max-width:380px;width:100%;padding:28px 26px;text-align:center;}
.modal-card p{color:var(--snow);font-size:0.98rem;line-height:1.55;margin:0 0 22px;}
.modal-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}

@media(prefers-reduced-motion:reduce){
  *{animation-duration:0.001s !important;animation-iteration-count:1 !important;transition-duration:0.001s !important;}
}
</style>
</head>
<body>
<canvas id="bg-canvas"></canvas>
<div id="toast-container" aria-live="polite"></div>
<canvas id="confetti-canvas"></canvas>
<button id="btn-mute" class="mute-btn" aria-label="Mute sound">🔊</button>

<div id="app">

  <!-- WELCOME -->
  <section id="screen-welcome" class="screen active">
    <div class="mtn-layer" id="mtn-layer"></div>
    <div class="welcome-inner">
      <div class="welcome-top">
        <div class="brandmark">
          <svg class="peak-icon" viewBox="0 0 26 26" fill="none"><path d="M2 21L10 6L14 13L17 8L24 21H2Z" fill="url(#g1)"/><defs><linearGradient id="g1" x1="2" y1="6" x2="24" y2="21"><stop stop-color="#f2c572"/><stop offset="1" stop-color="#c97f27"/></linearGradient></defs></svg>
          <span class="eyebrow">Trivia Ascent</span>
        </div>
      </div>
      <h1 class="welcome-title">SUMMIT</h1>
      <p class="welcome-tagline">One question. One step. One summit.<br>Climb an AI‑built ladder of trivia — bank your winnings before the altitude gets you.</p>
      <div class="name-row">
        <input id="input-name" type="text" placeholder="Your climber name" maxlength="18">
      </div>
      <div class="welcome-cta">
        <button class="btn btn-primary" id="btn-begin" style="padding:16px 40px;font-size:1rem;">Begin Ascent</button>
        <button class="link-btn" id="btn-view-lb">View global leaderboard</button>
      </div>
      <div class="best-badge" id="best-badge" style="display:none;">
        <span>⛺</span><span id="best-badge-text"></span>
      </div>
      <details class="howto">
        <summary>How the climb works</summary>
        <div class="howto-body">
          <p><b>15 questions, one ladder.</b> Each correct answer moves you up and raises the stakes. Miss one, and you fall back to your last <b>checkpoint</b> (level 5 and level 10 are safe havens) — walk away anytime to bank exactly what you've earned.</p>
          <p><b>Three lifelines, once each:</b> <b>50:50</b> clears two wrong answers, <b>Ask the Guide</b> gets a live AI opinion on the question, and <b>Skip</b> swaps in a fresh question at the same difficulty.</p>
          <p>Every question is generated live by AI for your chosen category — no two climbs are the same.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- CATEGORY -->
  <section id="screen-category" class="screen">
    <div class="cat-wrap">
      <div class="cat-header">
        <span class="eyebrow">Step 1 of 2</span>
        <h2>Choose your terrain</h2>
        <p>Pick a category — the AI builds your 15‑question ladder around it.</p>
