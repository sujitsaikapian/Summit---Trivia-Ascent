/* ============================================================
   CLAUDE API
============================================================ */
async function callClaude(system, user, maxTokens, retries){
  retries = retries || 0;
  const res=await fetch('https://api.anthropic.com/v1/messages',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      model:'claude-sonnet-4-6',
      max_tokens: maxTokens || 1000,
      system: system,
      messages:[{role:'user', content:user}]
    })
  });
  if(!res.ok){
    if(res.status===429 && retries>0){
      await new Promise(r=>setTimeout(r, 650+Math.random()*500));
      return callClaude(system, user, maxTokens, retries-1);
    }
    throw new Error('API error '+res.status);
  }
  const data=await res.json();
  const text=(data.content||[]).map(b=>b.text||'').join('');
  return text;
}
function parseJSONLoose(text){
  let t=text.trim();
  t=t.replace(/^```json/i,'').replace(/^```/,'').replace(/```$/,'').trim();
  return JSON.parse(t);
}
function validQuestion(q){
  return q && typeof q.question==='string' && Array.isArray(q.options) && q.options.length===4 &&
    Number.isInteger(q.correctIndex) && q.correctIndex>=0 && q.correctIndex<=3 &&
    typeof q.fact==='string' && typeof q.hostLine==='string';
}

const QUESTION_SYSTEM = "You are the question engine for SUMMIT, a trivia climbing game. You generate multiple-choice trivia questions.\n\n"+
  "CATEGORY RULE (strict): every question must be squarely and specifically about the exact category you are given for it. A person with no knowledge of that specific category should NOT be able to answer just from common sense or unrelated general knowledge. Never substitute a different category, and never write a question that could equally belong to some other subject. Do not repeat the same fact, subject, or near-duplicate question across the set you generate.\n\n"+
  "DIFFICULTY CALIBRATION (strict): you will be told a named tier for each question. Calibrate the real-world difficulty to match the tier, not just the wording:\n"+
  "- Beginner: obvious to almost anyone, including children.\n"+
  "- Easy: common knowledge for most adults.\n"+
  "- Medium: known to people who pay general attention to the subject; not obscure.\n"+
  "- Hard: requires real familiarity with the subject; not common knowledge.\n"+
  "- Expert: requires deep, enthusiast-level familiarity with the subject.\n"+
  "- Genius: requires specialist or academic-level knowledge, or connecting multiple facts.\n"+
  "- Impossible: extremely obscure or highly technical; only specialists or trivia champions would know it.\n"+
  "Each question in the set must feel meaningfully harder than the previous tier — never let a later, higher-tier question be easier than an earlier, lower-tier one.\n\n"+
  "Respond with ONLY a raw JSON array, no markdown code fences, no preamble, no explanation, no trailing text. Each element must be an object with exactly these fields: \"question\" (string, no numbering prefix), \"options\" (array of exactly 4 short strings, no A/B/C/D prefixes), \"correctIndex\" (integer 0-3, the index of the correct option), \"fact\" (string, one short interesting fact related to the answer, under 22 words, revealed to the player after they answer), \"hostLine\" (string, one short dramatic or witty remark under 16 words from 'The Guide', an enthusiastic expedition-guide host character, introducing the question). Ensure factual accuracy. Vary which index is correct across questions so it is not always the same position.";

function chunkPrompt(category, levelIndices){
  const lines = levelIndices.map(i => 'Level '+(i+1)+' — difficulty tier: '+TIERS[i]).join('\n');
  const catText = category.id==='mixed'
    ? "a broad mix of general trivia. For EACH question below, pick one single clear real-world subject (e.g. science, history, geography, pop culture, technology, sports, nature, art, mythology) and write a question that is squarely about that one subject only — do not blend subjects within a single question, and don't reuse the same subject twice in this set if you can help it"
    : "the category \""+category.name+"\" — EVERY question below must be unmistakably and specifically about \""+category.name+"\". If a question could just as easily belong to some other category, rewrite it so it clearly requires knowledge of \""+category.name+"\" specifically";
  return "Generate exactly "+levelIndices.length+" trivia questions for "+catText+".\n\n"+
    "Follow this exact difficulty progression — each question must be noticeably harder than the last, one question per line below, in this order:\n"+lines+"\n\n"+
    "Respond with ONLY a raw JSON array of exactly "+levelIndices.length+" objects, in the order listed above.";
}

async function generateChunk(category, levelIndices){
  const user = chunkPrompt(category, levelIndices);
  const text = await callClaude(QUESTION_SYSTEM, user, 1000, 1);
  const arr = parseJSONLoose(text);
  if(!Array.isArray(arr) || arr.length!==levelIndices.length) throw new Error('bad shape');
  arr.forEach(q=>{ if(!validQuestion(q)) throw new Error('bad question shape'); });
  return arr;
}

async function generateLadder(category){
  try{
    const chunks = await Promise.all([
      generateChunk(category, [0,1,2,3,4]),
      generateChunk(category, [5,6,7,8,9]),
      generateChunk(category, [10,11,12,13,14])
    ]);
    state.usedFallback=false;
    return chunks[0].concat(chunks[1]).concat(chunks[2]);
  }catch(e){
    console.warn('Ladder generation unavailable, using offline question set:', e);
    state.usedFallback=true;
    toast("Couldn't reach the AI right now — climbing with backup questions.");
    return Array.from({length:15}, (_, i)=>getFallbackQuestion(category.id, i));
  }
}

async function generateSingleQuestion(category, levelIndex){
  try{
    const user = chunkPrompt(category, [levelIndex]);
    const text = await callClaude(QUESTION_SYSTEM, user, 400, 1);
    const arr = parseJSONLoose(text);
    const q = Array.isArray(arr) ? arr[0] : arr;
    if(!validQuestion(q)) throw new Error('bad shape');
    return q;
  }catch(e){
    console.warn('Single question generation unavailable, using offline fallback:', e);
    return getFallbackQuestion(category.id, levelIndex, true);
  }
}

async function askExpert(q){
  const system = "You are 'The Guide', an AI trivia expert character inside the game SUMMIT. You will be shown a multiple-choice question. Give your honest best answer. If you are not fully certain, say so — do not fake confidence. Respond with ONLY a raw JSON object, no markdown, no preamble: {\"guess\": <integer 0-3>, \"confidence\": \"<Low|Medium|High|Very High>\", \"reasoning\": \"<2-3 sentence explanation in an expedition-guide voice>\"}.";
  const user = "Question: "+q.question+"\nOptions:\n0: "+q.options[0]+"\n1: "+q.options[1]+"\n2: "+q.options[2]+"\n3: "+q.options[3];
  const text = await callClaude(system, user, 300, 1);
  const obj = parseJSONLoose(text);
  if(!obj || !Number.isInteger(obj.guess)) throw new Error('bad expert response');
  return obj;
}

