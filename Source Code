function startTimer(seconds){
  stopTimer();
  state.timeLeft=seconds; state.timeTotal=seconds;
  const ring=$('timer-ring');
  ring.classList.remove('critical');
  const fill=$('timer-fill');
  const circumference=2*Math.PI*26;
  fill.style.strokeDasharray=circumference;
  fill.style.strokeDashoffset=0;
  $('timer-num').textContent=seconds;
  state.timerInterval=setInterval(()=>{
    state.timeLeft--;
    const pct = state.timeLeft/state.timeTotal;
    fill.style.strokeDashoffset = circumference*(1-pct);
    $('timer-num').textContent = Math.max(state.timeLeft,0);
    if(state.timeLeft<=10){ ring.classList.add('critical'); if(state.timeLeft>0) playTick(); }
    if(state.timeLeft<=0){
      stopTimer();
      if(!state.locked) selectAnswer(-1);
    }
  },1000);
}
function stopTimer(){
  if(state.timerInterval){ clearInterval(state.timerInterval); state.timerInterval=null; }
}

function selectAnswer(idx){
  if(state.locked) return;
  state.locked=true;
  stopTimer();
  const q=state.questions[state.currentIndex];
  const buttons=document.querySelectorAll('.opt-btn');
  buttons.forEach(b=>{ b.disabled=true; });
  if(idx>=0){
    if(idx===q.correctIndex){ buttons[idx].classList.add('correct'); }
    else{
      buttons[idx].classList.add('incorrect');
      buttons[q.correctIndex].classList.add('correct');
    }
  } else {
    buttons[q.correctIndex].classList.add('correct');
  }
  buttons.forEach((b,bi)=>{ if(bi!==idx && bi!==q.correctIndex) b.classList.add('dim'); });

  const correct = idx===q.correctIndex;
  if(correct) playCorrect(); else { playWrong(); $('q-card').classList.add('shake'); setTimeout(()=>$('q-card').classList.remove('shake'),400); }

  setTimeout(()=>{ if(correct) handleCorrect(); else handleWrong(); }, 1500);
}

function handleCorrect(){
  const i=state.currentIndex;
  const q=state.questions[i];
  if(CHECKPOINTS.has(i)) { toast('Checkpoint secured: '+fmtMoney(LEVELS[i])+' is yours no matter what.'); playCheckpoint(); confettiBurst(); }

  if(i===14){
    playSummit(); confettiBurst();
    setTimeout(()=>confettiBurst(),500);
    finishGame(LEVELS[14], 'summit', q);
    return;
  }

  $('q-card').style.display='none';
  document.querySelector('.controls-row').style.display='none';
  $('continue-panel').style.display='block';
  $('fact-txt').textContent = q.fact;
  $('btn-continue').onclick = ()=>{ state.currentIndex++; renderQuestion(); };
}

function handleWrong(){
  const i=state.currentIndex;
  const q=state.questions[i];
  const amount = lastCheckpointAmount(i);
  finishGame(amount, 'fell', q);
}

function walkAway(){
  const i=state.currentIndex;
  if(i===0) return;
  const amount = LEVELS[i-1];
  showConfirm('Bank '+fmtMoney(amount)+' and end your climb? You cannot come back to this question.', ()=>{
    stopTimer();
    playWalkAway();
    finishGame(amount, 'walked', null);
  });
}
function showConfirm(msg, onYes){
  $('confirm-text').textContent = msg;
  $('confirm-modal').style.display='flex';
  const yesBtn=$('confirm-yes'), noBtn=$('confirm-no');
  function cleanup(){
    $('confirm-modal').style.display='none';
    yesBtn.removeEventListener('click', yesHandler);
    noBtn.removeEventListener('click', noHandler);
  }
  function yesHandler(){ cleanup(); onYes(); }
  function noHandler(){ cleanup(); }
  yesBtn.addEventListener('click', yesHandler);
  noBtn.addEventListener('click', noHandler);
}

async function finishGame(amount, reason, q){
  stopTimer();
  musicEngine.stop();
  state.profile.gamesPlayed = (state.profile.gamesPlayed||0)+1;
  state.profile.bestAmount = Math.max(state.profile.bestAmount||0, amount);
  await saveProfile();

  $('result-eyebrow').textContent = state.category ? state.category.name : '';
  $('result-amt').textContent = fmtMoney(amount);

  if(reason==='summit'){
    $('result-title').textContent = '🏔️ Summit Conquered';
    $('result-copy').innerHTML = "You answered all 15 questions correctly and claimed the full jackpot. That's a perfect climb.";
  } else if(reason==='fell'){
    $('result-title').textContent = 'Your climb ends here';
    $('result-copy').innerHTML = 'The correct answer to level '+(state.currentIndex+1)+' was <span class="missed">"'+escapeHtml(q.options[q.correctIndex])+'"</span>. You keep your last checkpoint.';
  } else {
    $('result-title').textContent = 'Smart move, climber.';
    $('result-copy').innerHTML = 'You walked away and banked your winnings before the risk caught up with you.';
  }

  $('input-lb-name').value = state.profile.name || '';
  $('saved-note').style.display='none';
  window._pendingScore = {amount, category: state.category? state.category.name:'—'};
  showScreen('screen-result');
}

/* ============================================================
   LIFELINES
============================================================ */
function useFifty(){
  if(state.lifelines.fifty || state.locked) return;
  state.lifelines.fifty=true; updateLifelineButtons();
  const q=state.questions[state.currentIndex];
  const wrongIdxs=[0,1,2,3].filter(x=>x!==q.correctIndex);
  wrongIdxs.sort(()=>Math.random()-0.5);
  const remove=wrongIdxs.slice(0,2);
  state.removedOptions=remove;
  remove.forEach(idx=>{
    const btn=document.querySelector('.opt-btn[data-idx="'+idx+'"]');
    if(btn) btn.classList.add('removed');
  });
  toast('50:50 used — two wrong answers cleared.');
}

async function useExpert(){
  if(state.lifelines.expert || state.locked) return;
  state.lifelines.expert=true;
  const btn=$('life-expert');
  btn.disabled=true;
  const orig=btn.innerHTML;
  btn.innerHTML='<span class="spin"></span>';
  const askedIndex=state.currentIndex;
  const q=state.questions[askedIndex];
  try{
    const res=await askExpert(q);
    // Only apply the response if the player is still on the same, unanswered question —
    // otherwise a slow reply could pop up a hint for a question they've already left.
    if(state.currentIndex===askedIndex && !state.locked){
      const letters=['A','B','C','D'];
      const bubble=$('expert-bubble');
      bubble.style.display='block';
      bubble.innerHTML='<b>The Guide leans toward '+letters[res.guess]+'</b> ('+escapeHtml(String(res.confidence))+' confidence). '+escapeHtml(String(res.reasoning));
    }
  }catch(e){
    toast("The Guide's signal cut out — try another lifeline.");
    state.lifelines.expert=false;
  }
  btn.innerHTML=orig;
  updateLifelineButtons();
}

async function useSkip(){
  if(state.lifelines.skip || state.locked) return;
  state.lifelines.skip=true;
  const btn=$('life-skip');
  btn.disabled=true;
  const orig=btn.innerHTML;
  btn.innerHTML='<span class="spin"></span>';
  const askedIndex=state.currentIndex;
  try{
    const q=await generateSingleQuestion(state.category, askedIndex);
    // Only swap in the new question if the player is still sitting on the same,
    // unanswered question — otherwise a slow reply could yank them back to a
    // question they've already answered or advanced past.
    if(state.currentIndex===askedIndex && !state.locked){
      state.questions[askedIndex]=q;
      toast('Question swapped.');
      renderQuestion();
    }
  }catch(e){
    toast('Could not fetch a new question — try again.');
    state.lifelines.skip=false;
  }
  btn.innerHTML=orig;
  updateLifelineButtons();
}

/* ============================================================
   LEADERBOARD SCREEN
============================================================ */
async function renderLeaderboard(){
  const list=await loadLeaderboardData();
  const el=$('lb-list');
  if(list.length===0){
    el.innerHTML='<div class="lb-empty">No climbs recorded yet. Be the first to reach the summit.</div>';
    return;
  }
  el.innerHTML = list.slice(0,50).map((e,idx)=>{
    return '<div class="lb-row"><div class="lb-rank">#'+(idx+1)+'</div>'+
      '<div><div class="lb-name">'+escapeHtml(e.name||'Climber')+'</div><div class="lb-cat">'+escapeHtml(e.category||'')+'</div></div>'+
      '<div class="lb-amt">'+fmtMoney(e.amount)+'</div></div>';
  }).join('');
}
function escapeHtml(s){
  const d=document.createElement('div'); d.textContent=s; return d.innerHTML;
}

/* ============================================================
   WIRING
============================================================ */
function wire(){
  $('btn-begin').addEventListener('click', ()=>{
    ctx();
    const name=$('input-name').value.trim();
    state.profile.name = name || 'Climber';
    saveProfile();
    renderCategoryGrid();
    showScreen('screen-category');
  });
  $('input-name').addEventListener('keydown', e=>{ if(e.key==='Enter') $('btn-begin').click(); });

  $('btn-view-lb').addEventListener('click', async ()=>{ await renderLeaderboard(); showScreen('screen-leaderboard'); });
  $('btn-lb-back').addEventListener('click', ()=> showScreen('screen-welcome'));
  $('btn-cat-back').addEventListener('click', ()=> showScreen('screen-welcome'));
  $('btn-result-lb').addEventListener('click', async ()=>{ await renderLeaderboard(); showScreen('screen-leaderboard'); });

  $('btn-walk').addEventListener('click', walkAway);
  $('life-fifty').addEventListener('click', useFifty);
  $('life-expert').addEventListener('click', useExpert);
  $('life-skip').addEventListener('click', useSkip);

  $('btn-play-again').addEventListener('click', ()=>{
    renderCategoryGrid();
    showScreen('screen-category');
  });

  $('btn-mute').addEventListener('click', toggleMute);

  $('btn-save-lb').addEventListener('click', async ()=>{
    const nm=$('input-lb-name').value.trim() || state.profile.name || 'Climber';
    const p=window._pendingScore;
    if(!p) return;
    $('btn-save-lb').disabled=true;
    await addToLeaderboard({name:nm, amount:p.amount, category:p.category, date:Date.now()});
    $('saved-note').style.display='block';
    $('btn-save-lb').disabled=false;
  });
}

/* ============================================================
   INIT
============================================================ */
async function init(){
  initBg();
  initMountains();
  wire();
  await loadProfile();
  audioMuted = !!state.profile.audioMuted;
  updateMuteButton();
  renderWelcome();
}
document.addEventListener('DOMContentLoaded', init);

})();
</script>
