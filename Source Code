function confettiBurst(){
  const canvas=$('confetti-canvas'); const c2=canvas.getContext('2d');
  canvas.width=window.innerWidth; canvas.height=window.innerHeight;
  const colors=['#e8a33d','#f2c572','#8fb8d6','#f1eee6'];
  let parts=[];
  for(let i=0;i<90;i++){
    parts.push({
      x:canvas.width/2, y:canvas.height*0.35,
      vx:(Math.random()-0.5)*10, vy:(Math.random()-1.4)*10,
      size:4+Math.random()*4, color:colors[Math.floor(Math.random()*colors.length)],
      rot:Math.random()*360, vr:(Math.random()-0.5)*10, life:1
    });
  }
  let frame=0;
  function step(){
    frame++;
    c2.clearRect(0,0,canvas.width,canvas.height);
    parts.forEach(p=>{
      p.vy+=0.22; p.x+=p.vx; p.y+=p.vy; p.rot+=p.vr; p.life-=0.008;
      c2.save(); c2.translate(p.x,p.y); c2.rotate(p.rot*Math.PI/180);
      c2.globalAlpha=Math.max(p.life,0);
      c2.fillStyle=p.color; c2.fillRect(-p.size/2,-p.size/2,p.size,p.size*0.6);
      c2.restore();
    });
    parts=parts.filter(p=>p.life>0 && p.y<canvas.height+40);
    if(frame<220 && parts.length>0) requestAnimationFrame(step);
    else c2.clearRect(0,0,canvas.width,canvas.height);
  }
  step();
}

