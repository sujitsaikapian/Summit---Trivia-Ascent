const FALLBACK_CATEGORY_ORDER = ['general','science','technology','history','geography','movies','music','sports','space','math','nature'];
function getFallbackQuestion(categoryId, levelIndex, forceAlternate){
  let sourceCat = categoryId;
  let pool = FALLBACK_BY_CATEGORY[categoryId];
  if(categoryId==='mixed' || !pool){
    sourceCat = FALLBACK_CATEGORY_ORDER[levelIndex % FALLBACK_CATEGORY_ORDER.length];
    pool = FALLBACK_BY_CATEGORY[sourceCat];
  }
  if(forceAlternate){
    // Used by Skip: the normal pool slot for this (category, level) is exactly what's
    // already on screen (fallback picks are deterministic), so hop to the next category
    // in rotation at the same difficulty tier to guarantee a genuinely different question.
    const idx = FALLBACK_CATEGORY_ORDER.indexOf(sourceCat);
    const altCat = FALLBACK_CATEGORY_ORDER[((idx>=0?idx:levelIndex)+1) % FALLBACK_CATEGORY_ORDER.length];
    pool = FALLBACK_BY_CATEGORY[altCat];
  }
  const base = pool[levelIndex] || FALLBACK_BY_CATEGORY.general[levelIndex];
  return Object.assign({}, base, {hostLine: HOST_LINES[levelIndex]});
}

